# Server Configuration
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development

# Geographic Scope
GEO_SCOPE_NAME="Punjab, India"
GEO_SCOPE_LAT=31.1471
GEO_SCOPE_LNG=75.3412

# External API Endpoints
# Example values provided, DO NOT use real API keys here
GEOCODING_ENDPOINT=https://nominatim.openstreetmap.org
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
OSRM_ENDPOINT=http://router.project-osrm.org

# Ollama Local LLM
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL_NAME=llama3

# Workflow Restrictions and Tolerances
REQUEST_TIMEOUT_MS=10000
CORRIDOR_SEARCH_WIDTH_METERS=2000
MAX_EXTERNAL_REQUESTS=5
